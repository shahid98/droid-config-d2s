# Set wlan0 to its real (EFS) MAC before connman starts, so connman's wifi
# device ident - and therefore every saved service name - is the same on every
# boot. Without this, bcmdhd's pre-firmware random 00:90:4c:xx address becomes
# the ident, a new saved-service directory appears under
# /home/defaultuser/.local/share/system/privileged/connman/ on each boot, and
# Settings fills up with copies of the same network.
#
# See /usr/bin/d2s-wlan0-mac.sh for the full reasoning. The script is a no-op
# when the address already matches or wlan0 is already up, and its waits are
# deliberately short because connman is ordered after this.

[Unit]
Description=d2s: stable wifi ident - set wlan0 MAC from EFS before connman
After=droid-hal-init.service droid-wifi-firmware.service
# NOT Before=connman.service any more. Bringing wlan0 up is what powers the
# bcmdhd chip and loads its firmware, and that blocks for 10-22 s - time this
# unit has to spend, because without it there is no wifi at all. Holding
# connman for it put that straight into the boot path. It also bought nothing:
# the MAC set this unit exists for fails on every attempt here anyway
# ("RTNETLINK answers: No such device" while the driver re-creates the
# interface), so connman's ident churn is unfixed either way. Wifi working
# matters more than an ident, so let it run alongside connman instead.
ConditionPathExists=/sys/class/net

[Service]
Type=oneshot
RemainAfterExit=yes
# Long enough for the firmware load at the end (10-22 s) on top of the
# script's own 8 s MAC deadline. 15 s killed it mid-load and left wifi dead.
# No longer in the boot path, so this costs nothing but its own time.
TimeoutStartSec=60
ExecStart=/usr/bin/d2s-wlan0-mac.sh

[Install]
WantedBy=multi-user.target
