[Unit]
Description=Republish the d2s proximity sensor as an evdev device for sensorfw
# sensorfw's InputDevAdaptor enumerates /dev/input/* when the adaptor starts,
# so the device has to exist before sensorfwd looks for it.
Before=sensorfwd.service
After=droid-hal-init.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/bin/d2s-proximity-uinput.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
